# ssh ubuntu-vm  ->  Linux 虚拟机（VMware NAT 网段）
#
# 注意：私钥与 known_hosts 都放在工作区内。
# 原因：本机沙箱只允许写工作区，~/.ssh 被拒绝（ssh-keygen 会报 Permission denied）。
Host ubuntu-vm
  HostName 192.168.153.100
  User yjh
  Port 22
  IdentityFile D:/aixiangmu/.ssh/vm_ed25519
  IdentitiesOnly yes
  UserKnownHostsFile D:/aixiangmu/.ssh/known_hosts_vm
  StrictHostKeyChecking accept-new
